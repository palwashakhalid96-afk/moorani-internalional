        "            se = d.std(ddof=1) / np.sqrt(n_f)\n",
        "            print(f\"{names[i]:>5} vs {names[j]:<5}: mean diff = {d.mean():+.4f} (SE {se:.4f}) | \"\n",
        "                  f\"{names[i]} wins {int((d > 0).sum())}, ties {int((d == 0).sum())}, \"\n",
        "                  f\"{names[j]} wins {int((d < 0).sum())}\")\n",
        "\n",
        "    ranked = summary[\"CV Acc mean\"].sort_values(ascending=False)\n",
        "    print(f\"\\n>>> BEST by CV accuracy: {ranked.index[0]} ({ranked.iloc[0]:.4f})   \"\n",
        "          f\"ranking: \" + \" > \".join(f\"{k} ({v:.4f})\" for k, v in ranked.items()))\n",
        "\n",
        "    summary.round(4).to_csv(f\"{args.out}/tree_algorithms_summary.csv\")\n",
        "\n",
        "    # ------------------------------------------------------------------ plots\n",
        "    colors = {\"ID3\": \"#e07b39\", \"C4.5\": \"#3a7ebf\", \"CART\": \"#4aa564\"}\n",
        "    fig, axes = plt.subplots(2, 3, figsize=(16, 10))\n",
        "    for ax, nm in zip(axes[0], names):\n",
        "        cm = res[nm][\"cm\"]\n",
        "        ax.imshow(cm, cmap=\"Blues\")\n",
        "        ax.set_xticks(range(K), [c[:9] for c in cnames])\n",
        "        ax.set_yticks(range(K), [c[:9] for c in cnames])\n",
        "        for a in range(K):\n",
        "            for b in range(K):\n",
        "                ax.text(b, a, cm[a, b], ha=\"center\", va=\"center\", fontsize=13,\n",
        "                        color=\"white\" if cm[a, b] > cm.max() / 2 else \"black\")\n",
        "        acc, mf1, _ = summarize(cm)\n",
