      "source": [
        "\"\"\"\n",
        " ID3  vs  C4.5  vs  CART  -- all implemented from scratch (only NumPy for the algorithms).\n",
        "\n",
        " Dataset : Wine recognition (178 samples, 13 continuous features, 3 classes)  [sklearn built-in]\n",
        "          or any CSV:  --csv file.csv --target column\n",
        "\n",
        "Algorithm summary\n",
        "-----------------\n",
        "ID3   : categorical features, multiway split, Information Gain, no pruning.\n",
        "        (continuous features are first discretised into equal-frequency bins, because\n",
        "         ID3 cannot handle numeric attributes natively)\n",
        "C4.5  : Gain Ratio, continuous features via binary thresholds (with Quinlan's MDL penalty\n",
        "        on continuous gain), multiway split for categorical features, \"above-average gain\"\n",
        "        rule, min 2 cases per branch, pessimistic-error pruning (confidence 0.25).\n",
        "CART  : Gini impurity, strictly binary splits, full tree grown then pruned with\n",
        "        cost-complexity pruning (weakest-link); alpha chosen by inner 5-fold CV.\n",
        "\n",
        "Evaluation\n",
        "----------\n",
        "1) One stratified 70/30 hold-out split  -> confusion matrix, per-class precision/recall/F1\n",
        "2) Repeated stratified k-fold CV (default 5 x 5 = 25 folds, same folds for all algorithms)\n",
        "   -> mean +- std accuracy and macro-F1, aggregated confusion matrix, paired comparison.\n",
        "\n",
        "Usage:\n",
        "    python tree_algorithms_comparison.py\n",
        "    python tree_algorithms_comparison.py --csv data.csv --target label\n",
        "    \"\"\"\n",
        "\n",
        "\n",
        "import argparse\n",
        "import copy\n",
        "import time\n",
        "from statistics import NormalDist\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib\n",
        "matplotlib.use(\"Agg\")\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "\n",
        "# =============================================================================\n",
        "# Impurity helpers\n",
        "# =============================================================================\n",
        "def entropy_c(counts):\n",
        "    n = counts.sum()\n",
        "    if n == 0:\n",
        "        return 0.0\n",
        "    p = counts[counts > 0] / n\n",
        "    return float(-(p * np.log2(p)).sum())\n",
        "\n",
        "\n",
        "def impurity_rows(C, kind):\n",
        "    \"\"\"Impurity for each row of a (m, K) class-count matrix.\"\"\"\n",
        "    n = C.sum(axis=1, keepdims=True)\n",
        "    P = C / np.maximum(n, 1)\n",
        "    if kind == \"gini\":\n",
        "        return 1.0 - (P ** 2).sum(axis=1)\n",
        "    return -(P * np.log2(np.where(P > 0, P, 1.0))).sum(axis=1)\n",
        "\n",
        "\n",
        "# =============================================================================\n",
        "# Tree node + shared base class\n",
        "# =============================================================================\n",
        "class Node:\n",
        "    def __init__(self, counts):\n",
        "        self.counts = counts                  # class counts of training samples at this node\n",
        "        self.n = int(counts.sum())\n",
        "        self.majority = int(np.argmax(counts))\n",
        "        self.kind = \"leaf\"                    # \"leaf\" | \"num\" (binary threshold) | \"cat\" (multiway)\n",
        "        self.feature = None\n",
        "        self.threshold = None\n",
        "        self.left = None\n",
        "        self.right = None\n",
        "        self.children = None                  # dict {category: Node} for \"cat\"\n",
        "\n",
        "    @property\n",
        "    def is_leaf(self):\n",
        "        return self.kind == \"leaf\"\n",
        "\n",
        "    def make_leaf(self):\n",
        "        self.kind = \"leaf\"\n",
        "        self.feature = self.threshold = None\n",
        "        self.left = self.right = self.children = None\n",
        "\n",
        "    def kids(self):\n",
        "        if self.kind == \"num\":\n",
        "            return [self.left, self.right]\n",
        "        if self.kind == \"cat\":\n",
        "            return list(self.children.values())\n",
        "        return []\n",
        "\n",
        "\n",
        "def route(root, x):\n",
        "    \"\"\"Follow x down the tree; returns the node where it stops.\"\"\"\n",
        "    node = root\n",
        "    while not node.is_leaf:\n",
        "        if node.kind == \"num\":\n",
        "            node = node.left if x[node.feature] <= node.threshold else node.right\n",
        "        else:\n",
        "            child = node.children.get(int(x[node.feature]))\n",
        "            if child is None:          # category never seen in training -> use this node's majority\n",
        "                break\n",
        "            node = child\n",
        "    return node\n",
        "\n",
        "\n",
        "class BaseTree:\n",
        "    name = \"base\"\n",
        "\n",
        "    def _encode(self, y):\n",
        "        self.classes_, y_enc = np.unique(y, return_inverse=True)\n",
        "        self.K = len(self.classes_)\n",
        "        return y_enc\n",
        "\n",
        "    def _counts(self, y):\n",
        "        return np.bincount(y, minlength=self.K).astype(float)\n",
        "\n",
        "    def _transform(self, X):\n",
        "        return X\n",
        "\n",
        "    def predict(self, X):\n",
        "        Xt = self._transform(np.asarray(X, dtype=float))\n",
        "        idx = np.array([route(self.root_, x).majority for x in Xt])\n",
        "        return self.classes_[idx]\n",
        "\n",
        "    def score(self, X, y):\n",
        "        return float(np.mean(self.predict(X) == np.asarray(y)))\n",
        "\n",
        "    # ---- size statistics ----\n",
        "    def n_leaves(self):\n",
        "        def f(n):\n",
        "            return 1 if n.is_leaf else sum(f(c) for c in n.kids())\n",
        "        return f(self.root_)\n",
        "\n",
        "    def depth(self):\n",
        "        def f(n):\n",
        "            return 0 if n.is_leaf else 1 + max(f(c) for c in n.kids())\n",
        "        return f(self.root_)\n",
        "\n",
        "    # ---- best binary split of one numeric feature (vectorised sweep) ----\n",
        "    def _sweep(self, x, Y1, counts, kind, min_leaf):\n",
        "        n = len(x)\n",
        "        order = np.argsort(x, kind=\"mergesort\")\n",
        "        xs = x[order]\n",
        "        L = np.cumsum(Y1[order], axis=0)[:-1]          # class counts on the left of each cut\n",
        "        R = counts - L\n",
        "        nl = np.arange(1, n, dtype=float)\n",
        "        nr = n - nl\n",
        "        ok = (xs[:-1] != xs[1:]) & (nl >= min_leaf) & (nr >= min_leaf)\n",
        "        if not ok.any():\n",
        "            return None\n",
        "        parent = impurity_rows(counts[None, :], kind)[0]\n",
        "        gain = parent - (nl * impurity_rows(L, kind) + nr * impurity_rows(R, kind)) / n\n",
        "        gain = np.where(ok, gain, -np.inf)\n",
        "        i = int(np.argmax(gain))\n",
        "        return float(gain[i]), float((xs[i] + xs[i + 1]) / 2.0), int(nl[i])\n",
        "\n",
        "\n",
        "# =============================================================================\n",
        "# 1) ID3\n",
        "# =============================================================================\n",
        "class ID3(BaseTree):\n",
        "    name = \"ID3\"\n",
        "\n",
        "    def __init__(self, n_bins=5, categorical=(), max_depth=None):\n",
        "        self.n_bins = n_bins\n",
        "        self.categorical = set(categorical)\n",
        "        self.max_depth = max_depth\n",
        "\n",
        "    def _transform(self, X):\n",
        "        out = X.copy()\n",
        "        for j, edges in self.edges_.items():\n",
        "            out[:, j] = np.digitize(X[:, j], edges)\n",
        "        return out\n",
        "\n",
        "    def fit(self, X, y):\n",
        "        X = np.asarray(X, dtype=float)\n",
        "        y = self._encode(y)\n",
        "        qs = np.linspace(0, 1, self.n_bins + 1)[1:-1]\n",
        "        self.edges_ = {j: np.unique(np.quantile(X[:, j], qs))\n",
        "                       for j in range(X.shape[1]) if j not in self.categorical}\n",
        "        Xb = self._transform(X)\n",
        "        self.root_ = self._grow(Xb, y, set(range(X.shape[1])), 0)\n",
        "        return self\n",
        "\n",
        "    def _grow(self, X, y, feats, depth):\n",
        "        counts = self._counts(y)\n",
        "        node = Node(counts)\n",
        "        if (counts > 0).sum() == 1 or not feats or \\\n",
        "                (self.max_depth is not None and depth >= self.max_depth):\n",
        "            return node\n",
        "        n, base = len(y), entropy_c(counts)\n",
        "        best_f, best_gain = None, 1e-12\n",
        "        for f in feats:                                   # Information Gain of every attribute\n",
        "            gain = base\n",
        "            for v in np.unique(X[:, f]):\n",
        "                m = X[:, f] == v\n",
        "                gain -= m.sum() / n * entropy_c(self._counts(y[m]))\n",
        "            if gain > best_gain:\n",
        "                best_gain, best_f = gain, f\n",
        "        if best_f is None:\n",
        "            return node\n",
        "        node.kind, node.feature, node.children = \"cat\", best_f, {}\n",
        "        for v in np.unique(X[:, best_f]):                 # one branch per attribute value\n",
        "            m = X[:, best_f] == v\n",
        "            node.children[int(v)] = self._grow(X[m], y[m], feats - {best_f}, depth + 1)\n",
        "        return node\n",
        "\n",
        "\n",
        "# =============================================================================\n",
        "# 2) C4.5\n",
        "# =============================================================================\n",
        "class C45(BaseTree):\n",
        "    name = \"C4.5\"\n",
        "\n",
        "    def __init__(self, min_objs=2, cf=0.25, prune=True, categorical=(), max_depth=None):\n",
        "        self.min_objs = min_objs\n",
        "        self.cf = cf\n",
        "        self.prune = prune\n",
        "        self.categorical = set(categorical)\n",
        "        self.max_depth = max_depth\n",
        "\n",
        "    def fit(self, X, y):\n",
        "        X = np.asarray(X, dtype=float)\n",
        "        y = self._encode(y)\n",
        "        self.z_ = NormalDist().inv_cdf(1 - self.cf)\n",
        "        self.root_ = self._grow(X, y, 0)\n",
        "        if self.prune:\n",
        "            self._prune(self.root_)\n",
        "        return self\n",
        "\n",
        "    # --- attribute evaluation ---\n",
        "    def _eval_num(self, x, Y1, counts, n):\n",
        "        r = self._sweep(x, Y1, counts, \"entropy\", self.min_objs)\n",
        "        if r is None:\n",
        "            return None\n",
        "        gain, thr, nl = r\n",
        "        n_distinct = len(np.unique(x))\n",
        "        gain -= np.log2(max(n_distinct - 1, 1)) / n       # Quinlan's MDL penalty for continuous attrs\n",
        "        if gain <= 1e-12:\n",
        "            return None\n",
        "        p = np.array([nl, n - nl]) / n\n",
        "        split_info = -(p * np.log2(p)).sum()\n",
        "        return dict(gain=gain, gr=gain / split_info, thr=thr)\n",
        "\n",
        "    def _eval_cat(self, x, y, base):\n",
        "        n, vals = len(y), np.unique(x)\n",
        "        if len(vals) < 2:\n",
        "            return None\n",
        "        gain, sizes = base, []\n",
        "        for v in vals:\n",
        "            m = x == v\n",
        "            sizes.append(m.sum())\n",
        "            gain -= m.sum() / n * entropy_c(self._counts(y[m]))\n",
        "        if sum(s >= self.min_objs for s in sizes) < 2 or gain <= 1e-12:\n",
        "            return None\n",
        "        p = np.array(sizes) / n\n",
        "        split_info = -(p * np.log2(p)).sum()\n",
        "        return dict(gain=gain, gr=gain / split_info, thr=None)\n",
        "\n",
        "    def _grow(self, X, y, depth):\n",
        "        counts = self._counts(y)\n",
        "        node = Node(counts)\n",
        "        n = len(y)\n",
        "        if (counts > 0).sum() == 1 or n < 2 * self.min_objs or \\\n",
        "                (self.max_depth is not None and depth >= self.max_depth):\n",
        "            return node\n",
        "        Y1, base = np.eye(self.K)[y], entropy_c(counts)\n",
        "        cands = []\n",
        "        for f in range(X.shape[1]):\n",
        "            r = self._eval_cat(X[:, f], y, base) if f in self.categorical \\\n",
        "                else self._eval_num(X[:, f], Y1, counts, n)\n",
        "            if r:\n",
        "                r[\"f\"] = f\n",
        "                cands.append(r)\n",
        "        if not cands:\n",
        "            return node\n",
        "        avg_gain = np.mean([c[\"gain\"] for c in cands])                  # C4.5 rule: only attributes with\n",
        "        eligible = [c for c in cands if c[\"gain\"] >= avg_gain - 1e-12]  # >= average gain compete,\n",
        "        best = max(eligible, key=lambda c: c[\"gr\"])                     # then max Gain Ratio wins\n",
        "        f = best[\"f\"]\n",
        "        node.feature = f\n",
        "        if best[\"thr\"] is None:                                         # categorical: multiway\n",
        "            node.kind, node.children = \"cat\", {}\n",
        "            for v in np.unique(X[:, f]):\n",
        "                m = X[:, f] == v\n",
        "                node.children[int(v)] = self._grow(X[m], y[m], depth + 1)\n",
        "        else:                                                           # numeric: binary threshold\n",
        "            node.kind, node.threshold = \"num\", best[\"thr\"]\n",
        "            m = X[:, f] <= best[\"thr\"]\n",
        "            node.left = self._grow(X[m], y[m], depth + 1)\n",
        "            node.right = self._grow(X[~m], y[~m], depth + 1)\n",
        "        return node\n",
        "\n",
        "    # --- pessimistic error-based pruning ---\n",
        "    def _upper_err(self, n, e):\n",
        "        \"\"\"Upper confidence limit of the error count (normal approximation, as in C4.5).\"\"\"\n",
        "        if n == 0:\n",
        "            return 0.0\n",
        "        z, f = self.z_, e / n\n",
        "        u = (f + z * z / (2 * n) + z * np.sqrt(max(f / n - f * f / n + z * z / (4 * n * n), 0))) \\\n",
        "            / (1 + z * z / n)\n",
        "        return u * n\n",
        "\n",
        "    def _prune(self, node):\n",
        "        leaf_err = self._upper_err(node.n, node.n - node.counts.max())\n",
        "        if node.is_leaf:\n",
        "            return leaf_err\n",
        "        sub_err = sum(self._prune(c) for c in node.kids())\n",
        "        if leaf_err <= sub_err + 0.1:        # same tolerance as Quinlan's C4.5 source\n",
        "            node.make_leaf()\n",
        "            return leaf_err\n",
        "        return sub_err\n",
        "\n",
        "\n",
        "# =============================================================================\n",
        "# 3) CART  (+ cost-complexity pruning)\n",
        "# =============================================================================\n",
        "def _leaf_err_and_count(node):\n",
        "    if node.is_leaf:\n",
        "        return node.n - node.counts.max(), 1\n",
        "    e = l = 0\n",
        "    for c in node.kids():\n",
        "        ce, cl = _leaf_err_and_count(c)\n",
        "        e, l = e + ce, l + cl\n",
        "    return e, l\n",
        "\n",
        "\n",
        "def _internal_nodes(node):\n",
        "    if node.is_leaf:\n",
        "        return []\n",
        "    out = [node]\n",
        "    for c in node.kids():\n",
        "        out += _internal_nodes(c)\n",
        "    return out\n",
        "\n",
        "\n",
        "def _weakest_links(root, N):\n",
        "    \"\"\"g(t) = (R(t) - R(T_t)) / (|leaves(T_t)| - 1); return min g and all nodes attaining it.\"\"\"\n",
        "    pairs = []\n",
        "    for t in _internal_nodes(root):\n",
        "        sub_e, sub_l = _leaf_err_and_count(t)\n",
        "        pairs.append((((t.n - t.counts.max()) - sub_e) / N / (sub_l - 1), t))\n",
        "    g_min = min(g for g, _ in pairs)\n",
        "    return g_min, [t for g, t in pairs if g <= g_min + 1e-12]\n",
        "\n",
        "\n",
        "def prune_sequence(root, N):\n",
        "    t, alphas = copy.deepcopy(root), [0.0]\n",
        "    while not t.is_leaf:\n",
        "        g, nodes = _weakest_links(t, N)\n",
        "        for nd in nodes:\n",
        "            nd.make_leaf()\n",
        "        alphas.append(max(g, alphas[-1]))\n",
        "    return alphas\n",
        "\n",
        "\n",
        "def prune_to_alpha(root, N, alpha):\n",
        "    t = copy.deepcopy(root)\n",
        "    while not t.is_leaf:\n",
        "        g, nodes = _weakest_links(t, N)\n",
        "        if g > alpha + 1e-12:\n",
        "            break\n",
        "        for nd in nodes:\n",
        "            nd.make_leaf()\n",
        "    return t\n",
        "\n",
        "\n",
        "class CART(BaseTree):\n",
        "    name = \"CART\"\n",
        "\n",
        "    def __init__(self, prune=\"cv\", cv_folds=5, min_samples_leaf=1, seed=0):\n",
        "        self.prune = prune\n",
        "        self.cv_folds = cv_folds\n",
        "        self.min_samples_leaf = min_samples_leaf\n",
        "        self.seed = seed\n",
        "\n",
        "    def fit(self, X, y):\n",
        "        X = np.asarray(X, dtype=float)\n",
        "        y = self._encode(y)\n",
        "        self.N = len(y)\n",
        "        self.root_ = self._grow(X, y)\n",
        "        if self.prune == \"cv\":\n",
        "            self._cv_prune(X, y)\n",
        "        return self\n",
        "\n",
        "    def _grow(self, X, y):\n",
        "        counts = self._counts(y)\n",
        "        node = Node(counts)\n",
        "        n = len(y)\n",
        "        if (counts > 0).sum() == 1 or n < 2:\n",
        "            return node\n",
        "        Y1 = np.eye(self.K)[y]\n",
        "        best = (1e-12, None, None)\n",
        "        for f in range(X.shape[1]):\n",
        "            r = self._sweep(X[:, f], Y1, counts, \"gini\", self.min_samples_leaf)\n",
        "            if r and r[0] > best[0]:\n",
        "                best = (r[0], f, r[1])\n",
        "        if best[1] is None:\n",
        "            return node\n",
        "        _, f, thr = best\n",
        "        m = X[:, f] <= thr\n",
        "        node.kind, node.feature, node.threshold = \"num\", f, thr\n",
        "        node.left, node.right = self._grow(X[m], y[m]), self._grow(X[~m], y[~m])\n",
        "        return node\n",
        "\n",
        "    def _cv_prune(self, X, y):\n",
        "        alphas = prune_sequence(self.root_, self.N)\n",
        "        cands = sorted(set([(alphas[i] + alphas[i + 1]) / 2 for i in range(len(alphas) - 1)]\n",
        "                           + [alphas[-1]]))\n",
        "        folds = stratified_folds(y, self.cv_folds, self.seed)\n",
        "        scores = np.zeros(len(cands))\n",
        "        for i in range(self.cv_folds):\n",
        "            va = folds[i]\n",
        "            tr = np.concatenate([folds[j] for j in range(self.cv_folds) if j != i])\n",
        "            root = self._grow(X[tr], y[tr])\n",
        "            for j, a in enumerate(cands):\n",
        "                t = prune_to_alpha(root, len(tr), a)\n",
        "                scores[j] += np.mean([route(t, x).majority == yy for x, yy in zip(X[va], y[va])])\n",
        "        best = max(np.flatnonzero(scores >= scores.max() - 1e-12))   # ties -> simplest (largest alpha)\n",
        "        self.alpha_ = cands[best]\n",
        "        self.root_ = prune_to_alpha(self.root_, self.N, self.alpha_)\n",
        "\n",
        "\n",
        "# =============================================================================\n",
        "# Evaluation utilities\n",
        "# =============================================================================\n",
        "def stratified_split(y, test_size=0.3, seed=42):\n",
        "    rng = np.random.default_rng(seed)\n",
        "    te = []\n",
        "    for c in np.unique(y):\n",
        "        idx = np.flatnonzero(y == c)\n",
        "        rng.shuffle(idx)\n",
        "        te.extend(idx[: max(1, int(round(len(idx) * test_size)))])\n",
        "    te = np.array(sorted(te))\n",
        "    return np.setdiff1d(np.arange(len(y)), te), te\n",
        "\n",
        "\n",
        "def stratified_folds(y, k, seed=0):\n",
        "    rng = np.random.default_rng(seed)\n",
        "    folds = [[] for _ in range(k)]\n",
        "    for c in np.unique(y):\n",
        "        idx = np.flatnonzero(y == c)\n",
        "        rng.shuffle(idx)\n",
        "        start = int(rng.integers(k))\n",
        "        for i, j in enumerate(idx):\n",
        "            folds[(i + start) % k].append(j)\n",
        "    return [np.array(sorted(f)) for f in folds]\n",
        "\n",
        "\n",
        "def confusion(yt, yp, K):\n",
        "    cm = np.zeros((K, K), dtype=int)\n",
        "    np.add.at(cm, (yt, yp), 1)\n",
        "    return cm\n",
        "\n",
        "\n",
        "def prf(cm):\n",
        "    tp = np.diag(cm).astype(float)\n",
        "    prec = tp / np.maximum(cm.sum(0), 1)\n",
        "    rec = tp / np.maximum(cm.sum(1), 1)\n",
        "    f1 = np.where(prec + rec > 0, 2 * prec * rec / np.maximum(prec + rec, 1e-12), 0.0)\n",
        "    return prec, rec, f1, cm.sum(1)\n",
        "\n",
        "\n",
        "def summarize(cm):\n",
        "    _, _, f1, sup = prf(cm)\n",
        "    return np.trace(cm) / cm.sum(), f1.mean(), np.average(f1, weights=sup)\n",
        "\n",
        "\n",
        "def make_models(categorical=()):\n",
        "    return {\"ID3\": ID3(n_bins=5, categorical=categorical),\n",
        "            \"C4.5\": C45(categorical=categorical),\n",
        "            \"CART\": CART()}\n",
        "\n",
        "\n",
        "def load_data(args):\n",
        "    if args.csv:\n",
        "        df = pd.read_csv(args.csv).dropna()\n",
        "        y_raw = df[args.target].values\n",
        "        Xdf = df.drop(columns=[args.target])\n",
        "        cat_idx = [i for i, c in enumerate(Xdf.columns) if not pd.api.types.is_numeric_dtype(Xdf[c])]\n",
        "        for c in Xdf.columns[cat_idx]:\n",
        "            Xdf[c] = Xdf[c].astype(\"category\").cat.codes\n",
        "        classes, y = np.unique(y_raw, return_inverse=True)\n",
        "        return Xdf.values.astype(float), y, list(Xdf.columns), [str(c) for c in classes], cat_idx, args.csv\n",
        "    from sklearn.datasets import load_wine\n",
        "    d = load_wine()\n",
        "    return d.data, d.target, list(d.feature_names), [str(c) for c in d.target_names], [], \"Wine\"\n",
        "\n",
        "\n",
        "# =============================================================================\n",
        "# Main experiment\n",
        "# =============================================================================\n",
        "def main():\n",
        "    ap = argparse.ArgumentParser()\n",
        "    ap.add_argument(\"--csv\")\n",
        "    ap.add_argument(\"--target\")\n",
        "    ap.add_argument(\"--folds\", type=int, default=5)\n",
        "    ap.add_argument(\"--repeats\", type=int, default=5)\n",
        "    ap.add_argument(\"--test_size\", type=float, default=0.3)\n",
        "    ap.add_argument(\"--out\", default=\".\")\n",
        "    args = ap.parse_args()\n",
        "    if args.csv and not args.target:\n",
        "        ap.error(\"--target is required with --csv\")\n",
        "\n",
        "    X, y, feats, cnames, cat_idx, src = load_data(args)\n",
        "    K = len(cnames)\n",
        "    names = list(make_models().keys())\n",
        "    print(f\"Dataset: {src} | samples={len(y)} features={X.shape[1]} classes={K} {cnames}\")\n",
        "    print(f\"Class counts: {np.bincount(y).tolist()}\\n\")\n",
        "\n",
        "    # ------------------------------------------------------------------ hold-out\n",
        "    tr, te = stratified_split(y, args.test_size)\n",
        "    print(\"=\" * 78)\n",
        "    print(f\"A) HOLD-OUT  (train={len(tr)}, test={len(te)})\")\n",
        "    print(\"=\" * 78)\n",
        "    hold = {}\n",
        "    for nm, model in make_models(cat_idx).items():\n",
        "        t0 = time.time()\n",
        "        model.fit(X[tr], y[tr])\n",
        "        fit_t = time.time() - t0\n",
        "        cm = confusion(y[te], model.predict(X[te]), K)\n",
        "        acc, mf1, wf1 = summarize(cm)\n",
        "        p, r, f, s = prf(cm)\n",
        "        hold[nm] = dict(cm=cm, acc=acc, mf1=mf1, wf1=wf1, leaves=model.n_leaves(),\n",
        "                        depth=model.depth(), train_acc=model.score(X[tr], y[tr]), time=fit_t)\n",
        "        print(f\"\\n--- {nm}: test acc={acc:.4f} | macro-F1={mf1:.4f} | weighted-F1={wf1:.4f} | \"\n",
        "              f\"train acc={hold[nm]['train_acc']:.4f} | leaves={model.n_leaves()} depth={model.depth()}\"\n",
        "              + (f\" | alpha={model.alpha_:.4f}\" if nm == \"CART\" else \"\"))\n",
        "        print(pd.DataFrame(cm, index=[f\"true {c}\" for c in cnames],\n",
        "                           columns=[f\"pred {c}\" for c in cnames]).to_string())\n",
        "        print(pd.DataFrame({\"precision\": p, \"recall\": r, \"f1\": f, \"support\": s},\n",
        "                           index=cnames).round(3).to_string())\n",
        "\n",
        "    # ------------------------------------------------------------------ repeated CV\n",
        "    print(\"\\n\" + \"=\" * 78)\n",
        "    print(f\"B) REPEATED STRATIFIED CV  ({args.repeats} x {args.folds}-fold = \"\n",
        "          f\"{args.repeats * args.folds} folds, identical folds for every algorithm)\")\n",
        "    print(\"=\" * 78)\n",
        "    res = {nm: dict(acc=[], mf1=[], leaves=[], depth=[], cm=np.zeros((K, K), int)) for nm in names}\n",
        "    t0 = time.time()\n",
        "    for rep in range(args.repeats):\n",
        "        for va in stratified_folds(y, args.folds, seed=rep):\n",
        "            trn = np.setdiff1d(np.arange(len(y)), va)\n",
        "            for nm, model in make_models(cat_idx).items():\n",
        "                model.fit(X[trn], y[trn])\n",
        "                cm = confusion(y[va], model.predict(X[va]), K)\n",
        "                a, m, _ = summarize(cm)\n",
        "                res[nm][\"acc\"].append(a)\n",
        "                res[nm][\"mf1\"].append(m)\n",
        "                res[nm][\"leaves\"].append(model.n_leaves())\n",
        "                res[nm][\"depth\"].append(model.depth())\n",
        "                res[nm][\"cm\"] += cm\n",
        "    print(f\"(finished in {time.time() - t0:.1f}s)\\n\")\n",
        "\n",
